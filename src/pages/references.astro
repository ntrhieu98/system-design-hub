---
// /references — the three sources this course is built from, one card each.
// PDFs are served from public/references/ so "Xem" opens them in a new tab and
// "Tải xuống" saves the file; the ByteByteGo repo is external-only.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { REFERENCES } from '../data/references.js';

const B = import.meta.env.BASE_URL;
const local = REFERENCES.filter((r) => r.file);
const external = REFERENCES.filter((r) => !r.file);
const fileUrl = (r: string) => `${B}/${r}`;
---

<BaseLayout
  title="Nguồn tham khảo | System Design Hub"
  description="Sách và nguồn mà khoá học này dựa trên: System Design Interview (Alex Xu), 60 Days of System Design, và System Design 101 của ByteByteGo."
  active="references"
>
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={`${B}/`}>Trang chủ</a>
        <span aria-hidden="true">/</span>
        <span>Nguồn tham khảo</span>
      </nav>
      <h1 class="page-title">Nguồn tham khảo</h1>
      <p class="page-lead">
        Nội dung của site được tổng hợp và viết lại từ {REFERENCES.length} nguồn dưới đây. Sách gốc
        có bản quyền — {local.length} file PDF ở đây để bạn đọc và đối chiếu khi học, không phải để
        phát hành lại.
      </p>
      <div class="chip-row mt-4">
        <span class="chip chip-yellow">{REFERENCES.length} nguồn</span>
        <span class="chip">{local.length} bản PDF</span>
        <span class="chip">{external.length} nguồn online</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {REFERENCES.map((r) => (
          <article class="card ref-card">
            <div class="ref-head">
              <div class="card-ico bg-blue">{r.kind.startsWith('Repo') ? '{}' : 'PDF'}</div>
              <span class="chip chip-mono">{r.kind}</span>
            </div>

            <h2 class="card-title">{r.title}</h2>
            <p class="ref-author">{r.author}{r.size ? ` · ${r.size}` : ''}</p>

            <p class="card-text">{r.desc}</p>

            <p class="ref-why">{r.why}</p>

            <div class="ref-actions">
              {r.file ? (
                <>
                  <a class="btn btn-sm btn-primary" href={fileUrl(r.file)} target="_blank" rel="noopener">
                    <Icon name="file" size={14} /> Xem PDF
                  </a>
                  <a class="btn btn-sm btn-secondary" href={fileUrl(r.file)} download>
                    <Icon name="arrow" size={14} /> Tải xuống
                  </a>
                </>
              ) : (
                <a class="btn btn-sm btn-primary" href={r.external ?? '#'} target="_blank" rel="noopener">
                  <Icon name="git" size={14} /> Mở trên GitHub
                </a>
              )}
            </div>

            {r.file && r.external && (
              <p class="ref-note">
                Bản gốc / cập nhật:{' '}
                <a href={r.external} target="_blank" rel="noopener">{r.externalLabel}</a>
              </p>
            )}
            {!r.file && (
              <p class="ref-note">{r.externalLabel}</p>
            )}
          </article>
        ))}
      </div>

      <div class="callout callout-note mt-8">
        <div class="callout-ico">i</div>
        <div class="callout-body">
          <div class="callout-title">Cách dùng phần này</div>
          <p>
            Đọc một nguồn song song với module tương ứng, đừng đọc hết trước rồi mới vào site: sách
            cho bạn đề bài, site cho bạn cơ chế và trade-off. Với mỗi chương, ghi lại ba dòng — ý
            chính, điều áp dụng được, điều còn chưa hiểu (cách ghi chép này nằm ở
            <a href={`${B}/modules/7/resources`}>mục 7.6</a>).
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
