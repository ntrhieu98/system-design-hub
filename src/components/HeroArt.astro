            <text x="130" y="258" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="10" font-weight="800" fill="var(--art-ink)">Postgres leader</text>
            <text x="130" y="274" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">writes · ACID</text>
            <text x="130" y="288" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="8" fill="var(--art-faint)">p99 8ms</text>
  
            <rect x="238" y="236" width="156" height="60" rx="8" fill="var(--green-soft)" stroke="var(--art-line)" stroke-width="2"/>
            <text x="316" y="258" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="10" font-weight="800" fill="var(--art-ink)">Read replicas</text>
            <text x="316" y="274" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">3 × other AZ</text>
            <text x="316" y="288" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="8" fill="var(--art-faint)">lag ~200ms</text>
  
            <path d="M130,206 L130,234" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#heroArrow)"/>
            <path d="M214,266 L236,266" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#heroArrow)"/>
  
            <rect x="46" y="316" width="348" height="42" rx="8" fill="var(--red-soft)" stroke="var(--art-line)" stroke-width="2"/>
            <text x="220" y="334" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="9" font-weight="800" fill="var(--art-ink)">11.600 QPS read · 1.160 QPS write</text>
            <text x="220" y="349" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">36,5 TB / 10 năm · p99 mục tiêu 100ms</text>
  
            <rect x="46" y="372" width="112" height="34" rx="7" fill="var(--art-surface)" stroke="var(--art-line)" stroke-width="2"/>
            <text x="102" y="393" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">Monitoring</text>
            <rect x="170" y="372" width="112" height="34" rx="7" fill="var(--art-surface)" stroke="var(--art-line)" stroke-width="2"/>
            <text x="226" y="393" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">Tracing</text>
            <rect x="294" y="372" width="100" height="34" rx="7" fill="var(--art-surface)" stroke="var(--art-line)" stroke-width="2"/>
            <text x="344" y="393" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">Alerting</text>
          </svg>
</div>
