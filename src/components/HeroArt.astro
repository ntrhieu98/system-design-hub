            <text x="230" y="195" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">90% hit</text>
  
            <rect x="302" y="158" width="92" height="48" rx="8" fill="var(--yellow-soft)" stroke="var(--art-line)" stroke-width="2"/>
            <text x="348" y="179" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="10" font-weight="800" fill="var(--art-ink)">Queue</text>
            <text x="348" y="195" text-anchor="middle" font-family="Plus Jakarta Sans, sans-serif" font-size="8" fill="var(--ink-soft)">async</text>
  
            <path d="M346,132 L346,148 L102,148 L102,156" fill="none" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#heroArrow)"/>
            <path d="M102,206 L102,226 L230,226 L230,208" fill="none" stroke="var(--ink-soft)" stroke-width="2" marker-end="url(#heroArrow)"/>
  
