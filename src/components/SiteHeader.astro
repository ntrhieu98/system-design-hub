---
// Site header. The nav counts (8 modules / 6 ADR / 2 exercises) are props so
// they can come from src/data instead of being typed into the markup.
import Icon from '../components/Icon.astro';

interface Props {
  active?: 'home' | 'modules' | 'adr' | 'exercises' | 'path' | 'topic' | 'references';
  moduleCount?: number;
  adrCount?: number;
  exerciseCount?: number;
  topicCount?: number;
}

const {
  active = 'home',
  moduleCount = 8,
  adrCount = 6,
  exerciseCount = 2,
  topicCount = 64,
} = Astro.props;

const nav = [
  { key: 'home', href: '/', label: 'Trang chủ', icon: 'layers' },
  { key: 'modules', href: '/modules', label: 'Modules', icon: 'book', count: String(moduleCount) },
  { key: 'path', href: '/learning-path', label: 'Lộ trình', icon: 'git' },
  { key: 'adr', href: '/adr', label: 'ADR', icon: 'file', count: String(adrCount) },
  { key: 'exercises', href: '/exercises', label: 'Bài tập', icon: 'code', count: String(exerciseCount) },
  { key: 'references', href: '/references', label: 'Nguồn', icon: 'file' },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={`${import.meta.env.BASE_URL}/`} aria-label="System Design Hub — trang chủ">
      <span class="brand-mark"><Icon name="logo" size={20} /></span>
      <span class="brand-text">
        <span class="brand-title">
          System Design Hub
          <span class="badge badge-yellow" style="font-size:9px;padding:2px 7px;">VI</span>
        </span>
        <span class="brand-sub">8 modules · {adrCount} ADR · hands-on</span>
      </span>
    </a>

    <nav class="nav-links" aria-label="Điều hướng chính">
      {nav.map((n) => (
        <a class:list={['nav-link', { 'is-active': active === n.key }]} href={`${import.meta.env.BASE_URL}${n.href}`}>
          <Icon name={n.icon} size={16} />
          <span>{n.label}</span>
          {n.count && <span class="nav-count">{n.count}</span>}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="searchToggle" title="Tìm kiếm toàn site (Ctrl+K)" aria-label="Tìm kiếm toàn site" aria-expanded="false">
        <Icon name="search" size={16} />
      </button>
      <button class="icon-btn" id="themeToggle" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện">
        <Icon name="moon" size={16} />
      </button>
      <button class="icon-btn menu-btn" id="menuToggle" title="Mở menu" aria-label="Mở menu" aria-expanded="false">
        <Icon name="menu" size={16} />
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav">
    <div class="container">
      {nav.map((n) => (
        <a href={`${import.meta.env.BASE_URL}${n.href}`} class:list={[{ 'is-active': active === n.key }]}>
          <Icon name={n.icon} size={16} />
          <span>{n.label}</span>
        </a>
      ))}
    </div>
  </div>
</header>
