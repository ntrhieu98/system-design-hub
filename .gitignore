# macOS
.DS_Store
.AppleDouble

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Logs & temp
*.log
npm-debug.log*
.tmp/

# Python (when serving the site with a local HTTP server)
__pycache__/
*.py[cod]
.venv/

# Node (if tooling is added later)
node_modules/
.pnp.*
.yarn/

# Build output
dist/
build/

# Astro
.astro/

# Reference ebooks are large and copyrighted, so the copies at the repo root
# stay out of git. public/references/ is re-included below: those two files are
# what the /references page serves, so they must ship with the site.
*.pdf
!public/references/*.pdf

# Local docs & review reports
docs/
